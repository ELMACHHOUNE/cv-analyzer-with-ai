NODE_ENV=development
PORT=5000
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
# AI provider: groq | xai. Provider specific values (GROQ_*/XAI_*) win over AI_*.
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
AI_TIMEOUT_MS=90000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
OCR_LANGUAGES=eng
TRUST_PROXY=false
AUTH_RATE_LIMIT=20
AI_RATE_LIMIT=30
